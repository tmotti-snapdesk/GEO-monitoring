# Copie ce fichier en .env et remplace les valeurs par tes vraies clés API.
# Ne commit jamais le fichier .env (il est ignoré par .gitignore).
# En prod (GitHub Actions), ces mêmes variables sont des secrets du repo, pas
# un fichier .env — voir .github/workflows/geo-monitor.yml et le README.

# Optionnel : sans ces 2 variables, le run écrit dans un fichier SQLite local
# (backend/data.sqlite), comme avant. Renseigne-les pour écrire directement
# dans la base Turso de prod (mêmes valeurs que les secrets GitHub Actions).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optionnel : limite le run à certains moteurs (clés séparées par des virgules
# parmi chatgpt, claude, google_ai_overview, gemini). Vide/absent = les 4.
# Utile pour un premier test moins coûteux, ou si tu n'as pas encore toutes
# les clés (ex : pas de compte SerpApi pour google_ai_overview) :
ENGINES_ENABLED=claude,gemini

# Optionnel : limite le nombre de prompts testés (les N premiers de
# config/prompts.json). Vide/absent = les 100. Pratique pour un premier test.
PROMPT_END_INDEX=5

OPENAI_API_KEY=sk-...
# gpt-4o-search-preview = ChatGPT avec accès web (recommandé pour coller à la
# réalité). Mets "gpt-4o" pour revenir à la connaissance brute du modèle, sans web.
OPENAI_MODEL=gpt-4o-search-preview

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Modèle utilisé pour juger le sentiment des mentions de Snapdesk (voir
# backend/src/sentiment.js). Optionnel : si absent, ANTHROPIC_MODEL est réutilisé.
ANTHROPIC_SENTIMENT_MODEL=claude-sonnet-5

SERPAPI_API_KEY=...

# Clé Google AI Studio (aistudio.google.com/apikey) pour interroger Gemini.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
