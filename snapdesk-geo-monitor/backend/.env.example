# Copie ce fichier en .env et remplace les valeurs par tes vraies clés API.
# Ne commit jamais le fichier .env (il est ignoré par .gitignore).

OPENAI_API_KEY=sk-...
# gpt-4o-search-preview = ChatGPT avec accès web (recommandé pour coller à la
# réalité). Mets "gpt-4o" pour revenir à la connaissance brute du modèle, sans web.
OPENAI_MODEL=gpt-4o-search-preview

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Modèle utilisé pour juger le sentiment des mentions de Snapdesk (voir
# backend/src/sentiment.js). Optionnel : si absent, ANTHROPIC_MODEL est réutilisé.
ANTHROPIC_SENTIMENT_MODEL=claude-sonnet-5

SERPAPI_API_KEY=...

# Port sur lequel écoute l'API de résultats (npm run api)
API_PORT=4000
