# Copie ce fichier en .env.local — optionnel en local : par défaut (sans ces
# variables), le dashboard lit directement backend/data.sqlite, comme avant.
# Renseigne ces 2 variables uniquement si tu veux que ton dashboard local lise
# la base Turso de prod plutôt que le fichier SQLite local (mêmes valeurs que
# celles configurées sur Vercel — voir README).

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Nécessaire pour le bouton "Lancer un run" du dashboard (déclenche le
# workflow GitHub Actions à distance). Crée un fine-grained personal access
# token sur GitHub (Settings > Developer settings > Personal access tokens),
# limité au repo GEO-monitoring, avec la permission "Actions: Read and write".
GITHUB_TOKEN=
